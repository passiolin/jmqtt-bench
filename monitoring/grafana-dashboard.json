{
  "title": "jmqtt-broker 监控",
  "uid": "jmqtt-broker",
  "tags": ["jmqtt", "mqtt", "broker"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": [
    {"name": "node", "type": "query", "query": "label_values(jmqtt_connections_active, node)", "label": "节点", "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}
  ]},
  "panels": [
    {"id":1,"type":"row","title":"Broker 概览","gridPos":{"x":0,"y":0,"w":24,"h":1}},
    {"id":2,"type":"stat","title":"在线连接","gridPos":{"x":0,"y":1,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"jmqtt_connections_active","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"yellow","value":200000},{"color":"red","value":280000}]}}},"options":{"colorMode":"value","graphMode":"area"}},
    {"id":3,"type":"stat","title":"活跃会话","gridPos":{"x":4,"y":1,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"jmqtt_sessions_active","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"}},"options":{"colorMode":"value"}},
    {"id":4,"type":"stat","title":"活跃订阅","gridPos":{"x":8,"y":1,"w":4,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"jmqtt_subscriptions_active","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short"}},"options":{"colorMode":"value"}},
    {"id":5,"type":"stat","title":"上行消息速率","gridPos":{"x":12,"y":1,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(jmqtt_messages_published_total[1m]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"ops","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"yellow","value":3000},{"color":"red","value":4800}]}}},"options":{"colorMode":"value","graphMode":"area"}},
    {"id":6,"type":"stat","title":"下行消息丢弃","gridPos":{"x":18,"y":1,"w":6,"h":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(jmqtt_messages_dropped_total[1m]))","refId":"A"}],"fieldConfig":{"defaults":{"unit":"ops","color":{"mode":"thresholds"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":0.1}]}}},"options":{"colorMode":"value","graphMode":"none"}},
    {"id":10,"type":"timeseries","title":"连接数变化","gridPos":{"x":0,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"jmqtt_connections_active","legendFormat":"{{node}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","custom":{"fillOpacity":10,"lineWidth":2}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},
    {"id":11,"type":"timeseries","title":"接入/断开/拒绝 速率","gridPos":{"x":12,"y":5,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(jmqtt_connections_opened_total[1m])","legendFormat":"opened","refId":"A"},{"expr":"rate(jmqtt_connections_closed_total[1m])","legendFormat":"closed","refId":"B"},{"expr":"rate(jmqtt_connections_rejected_total[1m])","legendFormat":"rejected {{reason}}","refId":"C"}],"fieldConfig":{"defaults":{"unit":"ops","custom":{"fillOpacity":5}}},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}},
    {"id":12,"type":"timeseries","title":"消息发布/投递/丢弃 速率","gridPos":{"x":0,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(jmqtt_messages_published_total[1m]))","legendFormat":"published","refId":"A"},{"expr":"sum(rate(jmqtt_messages_delivered_total[1m]))","legendFormat":"delivered","refId":"B"},{"expr":"rate(jmqtt_messages_dropped_total[1m])","legendFormat":"dropped","refId":"C"}],"fieldConfig":{"defaults":{"unit":"ops","custom":{"fillOpacity":8}}},"options":{"legend":{"displayMode":"table","placement":"bottom","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}},
    {"id":13,"type":"timeseries","title":"发送队列积压","gridPos":{"x":12,"y":13,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"jmqtt_send_enqueued_total","legendFormat":"{{node}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","custom":{"fillOpacity":10}},"overrides":[]},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},

    {"id":20,"type":"row","title":"协议报文","gridPos":{"x":0,"y":21,"w":24,"h":1}},
    {"id":21,"type":"timeseries","title":"报文接收速率(按类型)","gridPos":{"x":0,"y":22,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (type)(rate(jmqtt_packets_received_total[1m]))","legendFormat":"{{type}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"ops","custom":{"fillOpacity":10}}},"options":{"legend":{"displayMode":"table","placement":"right","calcs":["lastNotNull"]},"tooltip":{"mode":"multi"}}},
    {"id":22,"type":"timeseries","title":"PINGREQ 速率","gridPos":{"x":12,"y":22,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(jmqtt_packets_received_total{type=\"PINGREQ\"}[1m]))","legendFormat":"PINGREQ/s","refId":"A"}],"fieldConfig":{"defaults":{"unit":"ops","custom":{"fillOpacity":10}}},"options":{"legend":{"displayMode":"list","placement":"bottom"},"tooltip":{"mode":"multi"}}},

    {"id":30,"type":"row","title":"集群总线","gridPos":{"x":0,"y":30,"w":24,"h":1}},
    {"id":31,"type":"timeseries","title":"集群总线上行/丢弃/outbox","gridPos":{"x":0,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(jmqtt_bus_uplink_total[1m])","legendFormat":"uplink/s {{node}}","refId":"A"},{"expr":"jmqtt_bus_outboxSize_total","legendFormat":"outbox {{node}}","refId":"B"},{"expr":"rate(jmqtt_bus_dropped_total[1m])","legendFormat":"dropped/s {{node}}","refId":"C"}],"fieldConfig":{"defaults":{"custom":{"fillOpacity":8}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},
    {"id":32,"type":"timeseries","title":"集群总线 skippedSelf / broadcastSkipped","gridPos":{"x":12,"y":31,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"rate(jmqtt_bus_skippedSelf_total[1m])","legendFormat":"skippedSelf {{node}}","refId":"A"},{"expr":"rate(jmqtt_bus_broadcastSkipped_total[1m])","legendFormat":"broadcastSkipped {{node}}","refId":"B"}],"fieldConfig":{"defaults":{"unit":"ops","custom":{"fillOpacity":8}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},

    {"id":40,"type":"row","title":"主机资源","gridPos":{"x":0,"y":39,"w":24,"h":1}},
    {"id":41,"type":"timeseries","title":"主机 CPU %","gridPos":{"x":0,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"100 - avg by(hostname)(rate(node_cpu_seconds_total{mode=\"idle\",hostname=~\"jmqtt-.*|pve\"}[5m])) * 100","legendFormat":"{{hostname}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"custom":{"fillOpacity":10,"thresholdsStyle":{"mode":"line"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":85}]}}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},
    {"id":42,"type":"timeseries","title":"主机内存使用率 %","gridPos":{"x":12,"y":40,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_memory_MemAvailable_bytes{hostname=~\"jmqtt-.*|pve\"} / node_memory_MemTotal_bytes{hostname=~\"jmqtt-.*\"}) * 100","legendFormat":"{{hostname}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"custom":{"fillOpacity":10,"thresholdsStyle":{"mode":"line"},"thresholds":{"steps":[{"color":"green"},{"color":"red","value":90}]}}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},
    {"id":43,"type":"timeseries","title":"根分区使用率 %","gridPos":{"x":0,"y":48,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"(1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",hostname=~\"jmqtt-.*|pve\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\",hostname=~\"jmqtt-.*|pve\"}) * 100","legendFormat":"{{hostname}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"percent","min":0,"max":100,"custom":{"fillOpacity":10}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},
    {"id":44,"type":"timeseries","title":"系统负载 load1","gridPos":{"x":12,"y":48,"w":12,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"node_load1{hostname=~\"jmqtt-.*|pve\"}","legendFormat":"{{hostname}}","refId":"A"}],"fieldConfig":{"defaults":{"custom":{"fillOpacity":8}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}},

    {"id":50,"type":"row","title":"Kafka 消费组","gridPos":{"x":0,"y":57,"w":24,"h":1}},
    {"id":51,"type":"timeseries","title":"下行消费组 Lag","gridPos":{"x":0,"y":58,"w":24,"h":8},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by(partition)(kafka_consumergroup_lag{consumergroup=\"jmqtt-broker-1-downlink\"})","legendFormat":"p{{partition}}","refId":"A"}],"fieldConfig":{"defaults":{"unit":"short","custom":{"fillOpacity":10}}},"options":{"legend":{"displayMode":"table","placement":"bottom"},"tooltip":{"mode":"multi"}}}
  ],
  "annotations": {"list": []},
  "links": [],
  "tags": ["jmqtt", "mqtt", "benchmark"]
}
